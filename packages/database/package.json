{
  "name": "@nexo/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "admin:grant": "tsx src/cli/grant-platform-admin.ts",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "db:migrate": "tsx src/cli/migrate.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0",
    "tsx": "4.23.12"
  },
  "devDependencies": {
    "@types/pg": "8.21.0"
  }
}
